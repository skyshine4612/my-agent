LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus
MODELSCOPE_TOKEN=ms-xxxxxxxx
TRAIN_12306_URL=https://mcp.api-inference.modelscope.net/xxxxxxxx/mcp
FLIGHT_VARIFLIGHT_URL=https://ai.variflight.com/servers/aviation/mcp/
VARIFLIGHT_API_KEY=sk-xxxxxxxx
UAPIS_API_KEY=uapi-xxxxxxxx
TAVILY_API_KEY=tvly-xxxxxxxx
AMAP_API_KEY=xxxxxxxx

# 向量化：知识库与长期记忆共用
EMBEDDING_API_KEY=sk-xxxxxxxx
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# 多模态：把攻略页插图转成文字描述
VISION_MODEL=qwen3.7-plus
VISION_API_KEY=sk-xxxxxxxx

# Supabase Postgres：应用表建在主库 postgres 的 public schema（与 auth schema 同库）
SUPABASE_DATABASE_URL=postgresql://postgres.<POOLER_TENANT_ID>:xxxxxxxx@<linux-ip>:5432/postgres
# 测试库：内含最小 auth 桩，DDL 与主库一致，不跑 GoTrue
SUPABASE_TEST_DATABASE_URL=postgresql://postgres.<POOLER_TENANT_ID>:xxxxxxxx@<linux-ip>:5432/agent_test
# 必须与 supabase/docker 的 .env 中 JWT_SECRET 完全一致（后端本地 HS256 验签用）
SUPABASE_JWT_SECRET=xxxxxxxx

# 代码执行沙箱（容器内用服务名；本地跑后端时指向 Linux 上映射出来的端口）
SANDBOX_URL=http://sandbox:8001
SANDBOX_TIMEOUT=60
# 会话文件目录（上传件与产物），与 RESULTS/result_dir 分两棵树
FILE_DIR=files
