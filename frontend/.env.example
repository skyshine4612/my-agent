# 复制为 frontend/.env 并填真实值；VITE_ 前缀的变量会在构建时内联进产物

# 浏览器直连 Supabase 的地址（GoTrue 登录用），必须是浏览器能访问到的地址。
# 自托管 Supabase 走 Kong 网关，默认端口 8000。
VITE_SUPABASE_URL=http://localhost:8000

# Supabase 匿名公钥（anon key）。它与 RLS 配套使用，可公开，但不能是 service_role key。
# 取自自托管 Supabase 的 docker/.env：ANON_KEY
VITE_SUPABASE_ANON_KEY=

# 高德 Web 端 JS key（地图组件用）
VITE_AMAP_WEB_JS_KEY=
